      position: 130,
      criticality: 'Criticality'
    }
  ]
  IRNStatus;


  /*
   * Criticality
   */
  @EndUserText.label: 'Criticality'
  @UI.hidden: true
  Criticality;


  /*
   * Cancellation Date
   */
  @EndUserText.label: 'Cancellation Date'
  @UI.lineItem: [
    { position: 140, importance: #MEDIUM }
  ]
  @UI.selectionField: [
    { position: 130 }
  ]
  @UI.identification: [
    { position: 140 }
  ]
  CancellationDate;


  /*
   * Cancellation Time
   */
  @EndUserText.label: 'Cancellation Time'
  @UI.lineItem: [
    { position: 150, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 150 }
  ]
  CancellationTime;


  /*
   * Created By
   */
  @EndUserText.label: 'Created By'
  @UI.lineItem: [
    { position: 160, importance: #LOW }
  ]
  @UI.selectionField: [
    { position: 140 }
  ]
  @UI.identification: [
    { position: 160 }
  ]
  CreatedBy;


  /*
   * Created Date
   */
  @EndUserText.label: 'Created Date'
  @UI.lineItem: [
    { position: 170, importance: #LOW }
  ]
  @UI.identification: [
    { position: 170 }
  ]
  CreatedDate;


  /*
   * Created Time
   */
  @EndUserText.label: 'Created Time'
  @UI.lineItem: [
    { position: 180, importance: #LOW }
  ]
  @UI.identification: [
    { position: 180 }
  ]
  CreatedTime;


  /*
   * Last Changed By
   */
  @EndUserText.label: 'Last Changed By'
  @UI.lineItem: [
    { position: 190, importance: #LOW }
  ]
  @UI.identification: [
