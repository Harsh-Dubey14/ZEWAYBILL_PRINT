  /*
   * Billing Time
   */
  @EndUserText.label: 'Billing Time'
  @UI.lineItem: [
    { position: 110, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 110 }
  ]
  BillingTime;


  /*
   * Status
   */
  @EndUserText.label: 'Status'
  @UI.lineItem: [
    {
      position: 120,
      importance: #HIGH,
      criticality: 'Criticality'
    }
  ]
  @UI.selectionField: [
    { position: 110 }
  ]
  @UI.identification: [
    {
      position: 120,
      criticality: 'Criticality'
    }
  ]
