  /*
   * IRN Status
   */
  @EndUserText.label: 'IRN Status'
  @UI.lineItem: [
    {
      position: 130,
      importance: #HIGH,
      criticality: 'Criticality'
    }
  ]
  @UI.selectionField: [
    { position: 120 }
  ]
  @UI.identification: [
