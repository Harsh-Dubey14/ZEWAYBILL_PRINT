@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'E-Invoice',
  typeNamePlural: 'E-Invoices',

  title: {
    type: #STANDARD,
    value: 'DocumentNumber'
  },

  description: {
    type: #STANDARD,
    value: 'EInvoiceNumber'
  },

  typeImageUrl: 'sap-icon://e-care'
}

annotate entity ZC_EWAY_BILL_PRINT with
{
  /*
   * Object Page Facets
   */
  @UI.facet: [
    {
      id: 'EInvoiceDetails',
      purpose: #STANDARD,
      type: #COLLECTION,
      label: 'E-Invoice Details',
      position: 10
    },
    {
      id: 'GeneralInformation',
      parentId: 'EInvoiceDetails',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'General Information',
      position: 10
    }
  ]


  /*
   * Company Code
   */
  @EndUserText.label: 'Company Code'
  @UI.lineItem: [
    { position: 10, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 10 }
  ]
  @UI.identification: [
    { position: 10 }
  ]
 
  CompanyCode;


  /*
   * Fiscal Year
   */
  @EndUserText.label: 'Fiscal Year'
  @UI.lineItem: [
    { position: 20, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 20 }
  ]
  @UI.identification: [
    { position: 20 }
  ]
//< >
  FiscalYear;


  /*
   * Document Number
   */
  @EndUserText.label: 'Document Number'
  @UI.lineItem: [
    { position: 30, importance: #HIGH },{ type: #FOR_ACTION , dataAction: 'PrintEwayBill', label: 'Generate Print'}
  ]
  @UI.selectionField: [
    { position: 30 }
  ]
  @UI.identification: [
    { position: 30 }
  ]
 
  DocumentNumber;


  /*
   * Document Type
   */
  @EndUserText.label: 'Document Type'
  @UI.lineItem: [
    { position: 40, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 40 }
  ]
  @UI.identification: [
    { position: 40 }
  ]
  DocumentType;


  /*
   * E-Invoice Number
   */
  @EndUserText.label: 'E-Invoice Number'
  @UI.lineItem: [
    { position: 50, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 50 }
  ]
  @UI.identification: [
    { position: 50 }
  ]
  EInvoiceNumber;


  /*
   * GSTIN
   */
  @EndUserText.label: 'GSTIN'
  @UI.lineItem: [
    { position: 60, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 60 }
  ]
  @UI.identification: [
    { position: 60 }
  ]
  GSTIN;


  /*
   * Plant
   */
  @EndUserText.label: 'Plant'
  @UI.lineItem: [
    { position: 70, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 70 }
  ]
  @UI.identification: [
    { position: 70 }
  ]
  Plant;


  /*
   * Invoice Reference Number
   */
  @EndUserText.label: 'Invoice Reference Number'
  @UI.lineItem: [
    { position: 80, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 80 }
  ]
  @UI.identification: [
    { position: 80 }
  ]
  IRN;


  /*
   * Generated Date
   */
  @EndUserText.label: 'Generated Date'
  @UI.lineItem: [
    { position: 90, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 90 }
  ]
  @UI.identification: [
    { position: 90 }
  ]
  GeneratedDate;


  /*
   * Billing Date
   */
  @EndUserText.label: 'Billing Date'
  @UI.lineItem: [
    { position: 100, importance: #HIGH }
  ]
  @UI.selectionField: [
    { position: 100 }
  ]
  @UI.identification: [
    { position: 100 }
  ]
